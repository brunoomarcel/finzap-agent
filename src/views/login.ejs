<!DOCTYPE html>
<html lang="pt-BR" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FinZap Agent | Login</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-full bg-slate-50 text-slate-900 font-['Inter'] antialiased flex items-center justify-center p-4">

  <div class="w-full max-w-md bg-white rounded-2xl border border-slate-200/80 p-6 sm:p-8 shadow-xl shadow-slate-200/50 space-y-6">
    
    <div class="flex items-center justify-center gap-2">
      <div class="w-9 h-9 rounded-xl bg-blue-600 text-white flex items-center justify-center shadow-md shadow-blue-500/20">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 0 1-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 7v5l3 3"></path>
        </svg>
      </div>
      <span class="text-xl font-bold text-slate-900">FinZap Agent</span>
      <span class="px-2 py-0.5 text-xs font-bold bg-blue-50 text-blue-600 border border-blue-200 rounded-full uppercase tracking-wider">Web</span>
    </div>

    <div class="text-center space-y-1">
      <h1 class="text-xl font-bold text-slate-900">Acesse sua conta</h1>
      <p class="text-xs sm:text-sm text-slate-500">Digite seu telefone e senha para acessar o painel</p>
    </div>

    <% if (error) { %>
      <div class="p-3 bg-red-50 border border-red-200 text-red-700 text-xs sm:text-sm rounded-xl font-medium">
        <%= error %>
      </div>
    <% } %>

    <form action="/login" method="POST" class="space-y-4">
      <div>
        <label for="telefone" class="block text-xs font-semibold text-slate-700 mb-1">Telefone / WhatsApp</label>
        <input type="text" id="telefone" name="telefone" class="w-full px-3.5 py-2.5 text-sm text-slate-800 bg-white border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 transition-all" placeholder="Ex: 5511999999999" required autofocus>
      </div>

      <div>
        <label for="senha" class="block text-xs font-semibold text-slate-700 mb-1">Senha</label>
        <input type="password" id="senha" name="senha" class="w-full px-3.5 py-2.5 text-sm text-slate-800 bg-white border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 transition-all" placeholder="Sua senha de acesso" required>
      </div>

      <button type="submit" class="w-full py-3 px-4 text-sm font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-xl shadow-md shadow-blue-500/20 transition-colors active:scale-95">
        Entrar
      </button>

      <div class="text-center pt-2">
        <a href="/register" class="text-xs sm:text-sm font-medium text-blue-600 hover:text-blue-700 hover:underline">
          Não tem uma conta? Cadastre-se
        </a>
      </div>
    </form>
  </div>

</body>
</html>
