<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FinZap Agent | Usuários Autorizados</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <!-- Navigation -->
  <nav class="navbar">
    <div class="brand">
      <div class="brand-icon">💬</div>
      <div>FinZap Agent</div>
    </div>
    <div class="nav-links">
      <a href="/" class="nav-link">Dashboard</a>
      <a href="/usuarios" class="nav-link active">Usuários Autorizados</a>
    </div>
  </nav>

  <div class="container">
    
    <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 2rem;">
      
      <!-- New User Form -->
      <div class="card">
        <div class="section-title">
          <span>➕</span> Cadastrar Novo Usuário
        </div>
        <form id="addUserForm">
          <div style="margin-bottom: 1rem;">
            <label style="display: block; font-size: 0.85rem; color: var(--text-muted); margin-bottom: 0.25rem;">Nome Completo:</label>
            <input type="text" id="nomeInput" class="text-input" style="width: 100%;" placeholder="Ex: Bruno Marcel" required>
          </div>
          <div style="margin-bottom: 1rem;">
            <label style="display: block; font-size: 0.85rem; color: var(--text-muted); margin-bottom: 0.25rem;">Telefone WhatsApp (com DDD):</label>
            <input type="text" id="telefoneInput" class="text-input" style="width: 100%;" placeholder="Ex: 5511999999999 ou 11999999999" required>
            <small style="color: var(--text-muted); font-size: 0.75rem; display: block; margin-top: 0.25rem;">Apenas este número terá acesso ao assistente no WhatsApp.</small>
          </div>
          <button type="submit" class="btn" style="width: 100%; justify-content: center;">Cadastrar Usuário</button>
        </form>
      </div>

      <!-- Users List -->
      <div class="card">
        <div class="section-title">
          <span>👥</span> Usuários Cadastrados no Banco
        </div>
        <div class="table-responsive">
          <table>
            <thead>
              <tr>
                <th>Nome</th>
                <th>Telefone</th>
                <th>Status</th>
                <th>Criado Em</th>
                <th>Ações</th>
              </tr>
            </thead>
            <tbody id="usersTableBody">
              <% if (users && users.length > 0) { %>
                <% users.forEach(u => { %>
                  <tr>
                    <td style="font-weight: 600;"><%= u.nome %></td>
                    <td><%= u.telefone %></td>
                    <td>
                      <span class="badge <%= u.ativo ? 'badge-receita' : 'badge-despesa' %>">
                        <%= u.ativo ? 'Ativo' : 'Inativo' %>
                      </span>
                    </td>
                    <td><%= new Date(u.created_at).toLocaleDateString('pt-BR') %></td>
                    <td>
                      <button onclick="deleteUser('<%= u.id %>')" class="btn btn-danger btn-sm">Excluir</button>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="5" style="text-align: center; color: var(--text-muted);">Nenhum usuário cadastrado na tabela 'usuarios'.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

    </div>

  </div>

  <script>
    document.getElementById('addUserForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const nome = document.getElementById('nomeInput').value;
      const telefone = document.getElementById('telefoneInput').value;

      try {
        const res = await fetch('/api/users', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ nome, telefone, ativo: true })
        });
        const data = await res.json();

        if (data.success) {
          alert('Usuário cadastrado com sucesso!');
          window.location.reload();
        } else {
          alert('Erro ao cadastrar: ' + data.error);
        }
      } catch (err) {
        alert('Erro de conexão: ' + err.message);
      }
    });

    async function deleteUser(id) {
      if (!confirm('Deseja realmente excluir este usuário?')) return;
      try {
        const res = await fetch(`/api/users/${id}`, { method: 'DELETE' });
        const data = await res.json();
        if (data.success) {
          window.location.reload();
        } else {
          alert('Erro: ' + data.error);
        }
      } catch (err) {
        alert('Erro ao excluir: ' + err.message);
      }
    }
  </script>
</body>
</html>
