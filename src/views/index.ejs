<!DOCTYPE html>
<html lang="pt-BR" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FinZap Agent | Dashboard Financeiro</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="min-h-full bg-slate-50 text-slate-900 font-['Inter'] antialiased flex flex-col overflow-x-hidden">

  <!-- Navigation Bar -->
  <nav class="sticky top-0 z-30 w-full bg-white/90 backdrop-blur-md border-b border-slate-200 px-4 py-3 sm:px-8">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      
      <div class="flex items-center gap-3">
        <button id="navToggle" class="sm:hidden p-2 rounded-xl text-slate-700 hover:bg-slate-100 active:bg-slate-200 transition-colors" aria-label="Abrir menu">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>

        <a href="/" class="flex items-center gap-2 text-lg font-bold text-slate-900 tracking-tight">
          <div class="w-8 h-8 rounded-lg bg-blue-600 text-white flex items-center justify-center flex-shrink-0 shadow-sm shadow-blue-500/20">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 0 1-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 7v5l3 3"></path>
            </svg>
          </div>
          <span>FinZap Agent</span>
          <span class="px-2 py-0.5 text-xs font-bold bg-blue-50 text-blue-600 border border-blue-200 rounded-full uppercase tracking-wider">Web</span>
        </a>
      </div>

      <div class="hidden sm:flex items-center gap-2">
        <a href="/" class="px-3.5 py-2 text-sm font-semibold text-blue-600 bg-blue-50 rounded-lg transition-colors">Meu Dashboard</a>
        <% if (user && (user.role || '').toUpperCase() === 'ADMIN') { %>
          <a href="/admin" class="px-3.5 py-2 text-sm font-medium text-slate-600 hover:text-blue-600 hover:bg-slate-100 rounded-lg transition-colors">Administração</a>
        <% } %>
        <div class="h-4 w-px bg-slate-200 mx-2"></div>
        <span class="text-sm font-semibold text-slate-800"><%= user.nome %></span>
        <a href="/logout" class="px-3 py-1.5 text-sm font-medium text-red-600 hover:bg-red-50 rounded-lg transition-colors">Sair</a>
      </div>

    </div>
  </nav>

  <!-- Mobile Drawer Menu -->
  <div id="drawerBackdrop" class="fixed inset-0 z-40 bg-slate-900/50 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300"></div>
  <aside id="drawer" class="fixed inset-y-0 left-0 z-50 w-72 max-w-[85vw] bg-white transform -translate-x-full transition-transform duration-300 ease-out shadow-2xl flex flex-col rounded-r-2xl overflow-y-auto">
    <div class="flex items-center justify-between p-4 border-b border-slate-100">
      <div class="flex items-center gap-2 text-base font-bold text-slate-900">
        <div class="w-7 h-7 rounded-lg bg-blue-600 text-white flex items-center justify-center">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 0 1-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
          </svg>
        </div>
        <span>FinZap Agent</span>
      </div>
      <button id="drawerClose" class="w-9 h-9 flex items-center justify-center rounded-full bg-slate-100 text-slate-500 hover:bg-slate-200 transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <% if (user) { %>
      <div class="p-4 bg-slate-50 border-b border-slate-100 flex items-center gap-3">
        <div class="w-11 h-11 rounded-full bg-gradient-to-tr from-blue-600 to-indigo-600 text-white flex items-center justify-center font-bold text-sm shadow-md shadow-blue-500/20 flex-shrink-0">
          <%= user.nome ? user.nome.split(' ').map(n => n[0]).slice(0, 2).join('').toUpperCase() : 'FZ' %>
        </div>
        <div class="min-w-0">
          <div class="text-sm font-bold text-slate-900 truncate"><%= user.nome %></div>
          <div class="text-xs text-slate-500 truncate"><%= user.telefone %></div>
          <span class="inline-block mt-1 px-2 py-0.5 text-[10px] font-semibold uppercase rounded-full <%= user.role === 'ADMIN' ? 'bg-blue-100 text-blue-700' : 'bg-slate-200 text-slate-700' %>">
            <%= user.role === 'ADMIN' ? 'Administrador' : 'Usuário' %>
          </span>
        </div>
      </div>
    <% } %>

    <nav class="flex-1 p-3 space-y-1">
      <a href="/" class="flex items-center gap-3 px-3.5 py-3 rounded-xl text-sm font-semibold bg-blue-50 text-blue-600">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 5a1 1 0 011-1h4a1 1 0 011 1v5a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM14 5a1 1 0 011-1h4a1 1 0 011 1v2a1 1 0 01-1 1h-4a1 1 0 01-1-1V5zM4 14a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1v-4zM14 12a1 1 0 011-1h4a1 1 0 011 1v7a1 1 0 01-1 1h-4a1 1 0 01-1-1v-7z"></path>
        </svg>
        <span>Meu Dashboard</span>
      </a>
      <% if (user && (user.role || '').toUpperCase() === 'ADMIN') { %>
        <a href="/admin" class="flex items-center gap-3 px-3.5 py-3 rounded-xl text-sm font-medium text-slate-700 hover:bg-slate-100 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
          <span>Administração</span>
        </a>
      <% } %>
    </nav>

    <div class="p-3 border-t border-slate-100">
      <a href="/logout" class="flex items-center gap-3 px-3.5 py-3 rounded-xl text-sm font-semibold text-red-600 hover:bg-red-50 transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
        </svg>
        <span>Sair da conta</span>
      </a>
    </div>
  </aside>

  <!-- Main Container -->
  <main class="flex-1 w-full max-w-7xl mx-auto px-4 py-6 sm:px-8 space-y-6">
    
    <!-- User Control Bar -->
    <div class="w-full bg-white rounded-2xl border border-slate-200/80 p-4 sm:p-5 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <div class="text-base font-bold text-slate-900"><%= user.nome %></div>
        <div class="text-xs text-slate-500"><%= user.telefone %></div>
        <input type="hidden" id="userSelect" value="<%= user.id %>">
      </div>

      <div class="w-full sm:w-auto">
        <label for="mesAnoSelect" class="block text-xs font-semibold text-slate-600 mb-1.5">Filtrar Mês/Ano</label>
        <input type="month" id="mesAnoSelect" class="w-full sm:w-60 px-3 py-2 text-sm text-slate-800 bg-white border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 transition-all" value="<%= new Date().toISOString().substring(0,7) %>">
      </div>
    </div>

    <!-- KPI Summary Cards -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
      <div class="bg-white rounded-2xl border border-slate-200/80 p-4 sm:p-5 shadow-sm">
        <div class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">Receitas do Mês</div>
        <div class="text-lg sm:text-2xl font-extrabold text-emerald-600 tracking-tight truncate" id="kpiReceitas">R$ 0,00</div>
      </div>

      <div class="bg-white rounded-2xl border border-slate-200/80 p-4 sm:p-5 shadow-sm">
        <div class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">Despesas do Mês</div>
        <div class="text-lg sm:text-2xl font-extrabold text-red-600 tracking-tight truncate" id="kpiDespesas">R$ 0,00</div>
      </div>

      <div class="bg-white rounded-2xl border border-slate-200/80 p-4 sm:p-5 shadow-sm">
        <div class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">Saldo Líquido</div>
        <div class="text-lg sm:text-2xl font-extrabold text-blue-600 tracking-tight truncate" id="kpiSaldo">R$ 0,00</div>
      </div>

      <div class="bg-white rounded-2xl border border-slate-200/80 p-4 sm:p-5 shadow-sm">
        <div class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">Total Transações</div>
        <div class="text-lg sm:text-2xl font-extrabold text-slate-800 tracking-tight truncate" id="kpiTransacoesCount">0</div>
      </div>
    </div>

    <!-- Main Content Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      
      <!-- Recent Transactions Section -->
      <div class="lg:col-span-2 bg-white rounded-2xl border border-slate-200/80 p-4 sm:p-6 shadow-sm min-w-0">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
          <h2 class="text-base sm:text-lg font-bold text-slate-900">Últimas Transações</h2>

          <!-- Batch Action Buttons -->
          <div class="flex items-center gap-2">
            <button id="btnDeleteSelected" onclick="deleteSelectedTransactions()" class="hidden px-3 py-1.5 text-xs font-semibold text-red-600 bg-red-50 border border-red-200 hover:bg-red-100 rounded-xl transition-colors active:scale-95">
              Excluir Selecionados (<span id="selectedCount">0</span>)
            </button>
            <button onclick="deleteAllTransactionsForUser()" class="px-3 py-1.5 text-xs font-semibold text-red-600 bg-white border border-red-200 hover:bg-red-50 rounded-xl transition-colors active:scale-95">
              Limpar Todas
            </button>
          </div>
        </div>

        <!-- Scrollable Table Box -->
        <div class="w-full overflow-x-auto border border-slate-200 rounded-xl">
          <table class="w-full text-left min-w-[580px]">
            <thead>
              <tr class="bg-slate-50 text-slate-500 text-xs font-bold uppercase tracking-wider border-b border-slate-200">
                <th class="p-3 text-center w-10">
                  <input type="checkbox" id="selectAllCheckbox" onclick="toggleSelectAll(this)" class="w-4 h-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 cursor-pointer">
                </th>
                <th class="px-4 py-3">Data</th>
                <th class="px-4 py-3">Descrição</th>
                <th class="px-4 py-3">Categoria</th>
                <th class="px-4 py-3">Método</th>
                <th class="px-4 py-3">Valor</th>
                <th class="px-4 py-3">Ações</th>
              </tr>
            </thead>
            <tbody id="transacoesTableBody">
              <tr>
                <td colspan="7" class="px-4 py-6 text-center text-sm text-slate-500">Carregando dados...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Budget Limits & Category Breakdown -->
      <div class="space-y-6 min-w-0">
        <div class="bg-white rounded-2xl border border-slate-200/80 p-4 sm:p-6 shadow-sm">
          <h2 class="text-base sm:text-lg font-bold text-slate-900 mb-4">Limites de Gastos</h2>
          <div id="limitesContainer" class="space-y-4">
            <p class="text-xs sm:text-sm text-slate-500">Nenhum limite definido para o período.</p>
          </div>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200/80 p-4 sm:p-6 shadow-sm">
          <h2 class="text-base sm:text-lg font-bold text-slate-900 mb-4">Gastos por Categoria</h2>
          <div class="h-60 relative">
            <canvas id="categoryChart"></canvas>
          </div>
        </div>
      </div>

    </div>

  </main>

  <script src="/js/app.js"></script>
  <script src="/js/dashboard.js"></script>
</body>
</html>
