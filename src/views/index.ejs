<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FinZap Agent | Dashboard Financeiro</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>

  <!-- Navigation -->
  <nav class="navbar">
    <div class="brand">
      <div>FinZap Agent</div>
      <span class="brand-tag">Web</span>
    </div>
    <div class="nav-links">
      <a href="/" class="nav-link active">Meu Dashboard</a>
      <% if (user && user.role === 'ADMIN') { %>
        <a href="/admin" class="nav-link">Administração</a>
      <% } %>
      <div class="nav-user">
        <span class="nav-user-name"><%= user.nome %></span>
        <a href="/logout" class="nav-link" style="padding: 0.2rem 0.5rem;">Sair</a>
      </div>
    </div>
  </nav>

  <div class="container">
    
    <!-- User Controls Bar -->
    <div class="filter-bar">
      <div>
        <div style="font-weight: 600; font-size: 1.05rem;"><%= user.nome %></div>
        <div style="font-size: 0.85rem; color: var(--text-muted);"><%= user.telefone %></div>
        <input type="hidden" id="userSelect" value="<%= user.id %>">
      </div>

      <div>
        <label for="mesAnoSelect" style="font-size: 0.8rem; color: var(--text-muted); display: block; margin-bottom: 0.2rem; font-weight: 600;">Filtrar Mês/Ano</label>
        <input type="month" id="mesAnoSelect" class="text-input" value="<%= new Date().toISOString().substring(0,7) %>">
      </div>
    </div>

    <!-- Top KPI Cards -->
    <div class="grid-cards">
      <div class="card">
        <div class="card-subtitle">Receitas do Mês</div>
        <div class="card-value value-green" id="kpiReceitas">R$ 0,00</div>
      </div>
      <div class="card">
        <div class="card-subtitle">Despesas do Mês</div>
        <div class="card-value value-red" id="kpiDespesas">R$ 0,00</div>
      </div>
      <div class="card">
        <div class="card-subtitle">Saldo Líquido</div>
        <div class="card-value value-blue" id="kpiSaldo">R$ 0,00</div>
      </div>
      <div class="card">
        <div class="card-subtitle">Total de Transações</div>
        <div class="card-value" id="kpiTransacoesCount">0</div>
      </div>
    </div>

    <!-- Main Grid: Transactions & Budget Limits -->
    <div class="grid-main">
      
      <!-- Recent Transactions Table -->
      <div class="card">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 0.5rem;">
          <div class="section-title" style="margin-bottom: 0;">Últimas Transações</div>

          <!-- Batch Actions Toolbar -->
          <div style="display: flex; gap: 0.5rem; align-items: center;">
            <button id="btnDeleteSelected" onclick="deleteSelectedTransactions()" class="btn btn-danger btn-sm" style="display: none;">
              Excluir Selecionados (<span id="selectedCount">0</span>)
            </button>
            <button onclick="deleteAllTransactionsForUser()" class="btn btn-danger btn-sm">
              Limpar Todas
            </button>
          </div>
        </div>

        <div class="table-responsive">
          <table>
            <thead>
              <tr>
                <th style="width: 36px; text-align: center;">
                  <input type="checkbox" id="selectAllCheckbox" onclick="toggleSelectAll(this)" style="cursor: pointer;">
                </th>
                <th>Data</th>
                <th>Descrição</th>
                <th>Categoria</th>
                <th>Método</th>
                <th>Valor</th>
                <th>Ações</th>
              </tr>
            </thead>
            <tbody id="transacoesTableBody">
              <tr>
                <td colspan="7" style="text-align: center; color: var(--text-muted);">Carregando dados...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Budget Limits & Category Chart -->
      <div>
        <div class="card" style="margin-bottom: 1.25rem;">
          <div class="section-title">Limites de Gastos</div>
          <div id="limitesContainer">
            <p style="color: var(--text-muted); font-size: 0.85rem;">Nenhum limite definido para o período.</p>
          </div>
        </div>

        <div class="card">
          <div class="section-title">Gastos por Categoria</div>
          <div style="max-height: 240px; position: relative;">
            <canvas id="categoryChart"></canvas>
          </div>
        </div>
      </div>

    </div>

  </div>

  <script src="/js/dashboard.js"></script>
</body>
</html>
