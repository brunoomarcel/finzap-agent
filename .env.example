PORT=3000
NODE_ENV=development

# Database / Prisma Connection String (Supabase Direct or Pooler Postgres Connection)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?schema=public"

# Supabase Client SDK (Fallback)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-or-anon-key

# Evolution API Go
EVOLUTION_API_URL=https://evogo.medainer.com.br
EVOLUTION_API_KEY=your-evolution-api-key
EVOLUTION_INSTANCE_NAME=finzap

# GROQ Cloud AI (Llama 3.3 70B)
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
